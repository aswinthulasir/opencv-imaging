            },
            "source": [
                "# Perspective Transformation"
            ]
        },
        {
            "cell_type": "code",
            "metadata": {
                "id": "5626971d",
                "language": "python"
            },
            "source": [
                "import cv2",
                "import numpy as np",
                "import matplotlib.pyplot as plt"
            ]
        },
        {
            "cell_type": "code",
            "metadata": {
                "id": "ca014e9c",
                "language": "python"
            },
            "source": [
                "image = cv2.imread(\"./giraffe-Kenya.png\")",
                "image_rgb = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)",
                "",
                "plt.imshow(image_rgb)"
            ]
        },
        {
            "cell_type": "code",
            "metadata": {
                "id": "4f976f0a",
                "language": "python"
            },
            "source": [
                "image_rgb.shape"
            ]
        },
        {
            "cell_type": "code",
            "metadata": {
                "id": "7c62fc43",
                "language": "python"
            },
            "source": [
                "rows, cols, _ = image_rgb.shape",
                "",
                "input_points = np.float32([[50, 50], [cols - 50, 50], [50, rows-50], [cols-50, rows-50]])",
                "",
                "output_points = np.float32([[10, 100], [cols - 100, 50], [100, rows-10], [cols-50, rows-100]])",
                "",
                "'''",
                "Trasformation matrix for Perspective trasformation",
                "",
                "3x3",
                "",
                "a, b, c",
                "d, e, f",
                "g, h, 1",
                "",
                "a,b,c is responsioble for horizontal scaling, rotation and tranlation",
                "d,e,f is responsioble for vertical scaling, rotation and tranlation",
                "g,h  : Perspective components that account for depth and skew",
                "",
                "'''",
                "",
                "M = cv2.getPerspectiveTransform(input_points, output_points)",
                "",
                "print(M)"
            ]
        },
        {
            "cell_type": "code",
            "metadata": {
                "id": "31122370",
                "language": "python"
            },
            "source": [
                "perspective_image = cv2.warpPerspective(image_rgb, M, (cols, rows))",
                "",
                "plt.figure(figsize=(10,5))",
                "",
                "plt.subplot(1,2,1)",
                "plt.imshow(image_rgb)",
                "plt.title(\"Original Image\")",
                "plt.axis(\"off\")",
                "",
                "plt.subplot(1,2,2)",
                "plt.imshow(perspective_image)",
                "plt.title(\"perspective Transformed Image\")",
                "plt.axis(\"off\")"
            ]
        },
        {
            "cell_type": "markdown",
            "metadata": {
                "id": "686ed6d9",
                "language": "markdown"
            },
            "source": [
                "# Affine transformation"
            ]
        },
        {
            "cell_type": "code",
            "metadata": {
                "id": "22f9dbf8",
                "language": "python"
            },
            "source": [
                "input_points = np.float32([[50,50], [200, 50], [50, 200]])",
                "",
                "output_points = np.float32([[10,100], [200, 50], [100, 250]])",
                "",
                "",
                "M = cv2.getAffineTransform(input_points, output_points)",
                "",
                "affine_image = cv2.warpAffine(image_rgb, M, (cols, rows))",
                "",
                "plt.figure(figsize=(10,5))",
                "",
                "plt.subplot(1,2,1)",
                "plt.imshow(image_rgb)",
                "plt.title(\"Original Image\")",
                "plt.axis(\"off\")",
                "",
                "plt.subplot(1,2,2)",
                "plt.imshow(affine_image)",
                "plt.title(\"Affine Transformed Image\")",
                "plt.axis(\"off\")"
            ]
        },
        {
            "cell_type": "markdown",
            "metadata": {
                "id": "0963c2c4",
                "language": "markdown"
            },
            "source": [
                "# Rotation"
            ]
        },
        {
            "cell_type": "code",
            "metadata": {
                "id": "2f5b3e9c",
                "language": "python"
            },
            "source": [
                "angle = 45",
                "center = (cols // 2, rows // 2)",
                "scale = 1.0",
                "",
                "M = cv2.getRotationMatrix2D(center,angle, scale)",
                "",
                "rotated_image = cv2.warpAffine(image_rgb, M, (cols, rows))",
                "",
                "plt.figure(figsize=(10,5))",
                "",
                "plt.subplot(1,2,1)",
                "plt.imshow(image_rgb)",
                "plt.title(\"Original Image\")",
                "plt.axis(\"off\")",
                "",
                "plt.subplot(1,2,2)",
                "plt.imshow(rotated_image)",
                "plt.title(\"Affine rotated Image\")",
                "plt.axis(\"off\")"
            ]
        },
        {
            "cell_type": "code",
            "metadata": {
                "id": "3a6d1c8c",
                "language": "python"
            },
            "source": [
                "# angle = 45",
                "# center = (cols // 2, rows // 2)",
                "# scale = 1.0",
                "",
                "shear_x, shear_y = 0.5, 0",
                "",
                "M = np.float32([[1, shear_x, 0], ",
                "           [shear_y, 1, 0]])",
                "",
                "",
                "sheared_image = cv2.warpAffine(image_rgb, M, (cols*2, rows))",
                "",
                "plt.figure(figsize=(10,5))",
                "",
                "plt.subplot(1,2,1)",
                "plt.imshow(image_rgb)",
                "plt.title(\"Original Image\")",
                "plt.axis(\"off\")",
                "",
                "plt.subplot(1,2,2)",
                "plt.imshow(sheared_image)",
                "plt.title(\"Sheared Image\")",
                "plt.axis(\"off\")"
            ]
        },
        {
            "cell_type": "markdown",
            "metadata": {
                "id": "df5d5baa",
                "language": "markdown"
            },
            "source": [
                "# Translation"
            ]
        },
        {
            "cell_type": "code",
            "metadata": {
                "id": "3b7fcb35",
                "language": "python"
            },
            "source": [
                "# angle = 45",
                "# center = (cols // 2, rows // 2)",
                "# scale = 1.0",
                "",
                "tx, ty = 200, 300",
                "",
                "M = np.float32([[1, 0, tx], ",
                "           [0, 1, ty]])",
                "",
                "",
                "translated_image = cv2.warpAffine(image_rgb, M, (cols, rows))",
                "",
                "plt.figure(figsize=(10,5))",
                "",
                "plt.subplot(1,2,1)",
                "plt.imshow(image_rgb)",
                "plt.title(\"Original Image\")",
                "plt.axis(\"off\")",
                "",
                "plt.subplot(1,2,2)",
                "plt.imshow(translated_image)",
                "plt.title(\"translated Image\")",
                "plt.axis(\"off\")"
            ]
        },
